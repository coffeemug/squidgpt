# Copy to .env and fill in. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here

# Game parameter defaults, read at startup. CLI flags (--n-agents,
# --speaking-passes, --word-cap) override these; if a variable is unset,
# the spec default (shown here) is used.
N_AGENTS=6
SPEAKING_PASSES=2
WORD_CAP=80
